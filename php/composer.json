{
    "name": "apiverve/jwtdecoder",
    "description": "JWT Decoder decodes JWT tokens to reveal header and payload information without performing signature verification. It handles JSON web token decode from any language over REST, so you can inspect claims and expiry without adding a JWT library.",
    "version": "1.2.2",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "APIVerve",
            "email": "hello@apiverve.com",
            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "jwtdecoder",
        "json web token decode",
        "jwt decoder api",
        "json token decode",
        "jwt decode",
        "jwt decoder"
    ],
    "homepage": "https://apiverve.com/marketplace/jwtdecoder?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/jwtdecoder",
        "source": "https://github.com/apiverve/jwtdecoder-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Jwtdecoder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "APIVerve\\Jwtdecoder\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
